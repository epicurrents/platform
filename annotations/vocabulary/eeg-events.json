{
    "standard": "epicurrents.eeg",
    "version": "2.0",
    "description": "The EEG vocabulary, stacked on the shared biosignal set: the activation procedures and stimuli a technologist applies to provoke a change in the EEG, which is the one category the module adds. Findings, the patterns a reader names, are coded in HED-SCORE. A term's `hed` crosswalk names its HED-SCORE equivalent where one exists.",
    "categories": {
        "ACTIVATION": {
            "scope": "acquisition",
            "description": "Activation procedures and the stimuli a technologist applies to provoke a change in the EEG. Eyes closed and open are state-like: an instant marks entry into the state until the next eye event, a span bounds it.",
            "events": {
                "EYES_CLOSED": {
                    "code": "EEG_ACT_EC",
                    "name": "Eyes closed",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "MDC/2:24320",
                        "ieee": "MDC_EOG_EYE_MVMT_CLOSING",
                        "hed": "Eyes-closed"
                    },
                    "description": "State-like: the eyes closed here and stay closed until the next eye event."
                },
                "EYES_OPEN": {
                    "code": "EEG_ACT_EO",
                    "name": "Eyes open",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "MDC/2:24328",
                        "ieee": "MDC_EOG_EYE_MVMT_OPENING",
                        "hed": "Eyes-open"
                    },
                    "description": "State-like: the eyes opened here and stay open until the next eye event."
                },
                "HYPERVENTILATION": {
                    "code": "EEG_ACT_HV",
                    "name": "Hyperventilation",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "SCT/68978004",
                        "hed": "Hyperventilation"
                    },
                    "description": "A span covering the whole hyperventilation; the start and end terms mark its edges as instants."
