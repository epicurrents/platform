{
    "standard": "epicurrents.eeg",
    "version": "1.0",
    "description": "The EEG vocabulary, stacked on the shared biosignal set. Each category carries a scope: ACTIVATION is acquisition-scoped, the procedures and stimuli applied to provoke a change; the rest are finding-scoped, the patterns a reader names. A platform registers the acquisition categories only; findings are standardised through HED-SCORE.",
    "categories": {
        "ACTIVATION": {
            "scope": "acquisition",
            "description": "Activation procedures and the stimuli a technologist applies to provoke a change in the EEG. Eyes closed and open are state-like: an instant marks entry into the state until the next eye event, a span bounds it.",
            "events": {
                "EYES_CLOSED": {
                    "code": "EEG_ACT_EC",
                    "name": "Eyes closed",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "MDC/2:24320",
                        "ieee": "MDC_EOG_EYE_MVMT_CLOSING"
                    },
                    "description": "State-like: the eyes closed here and stay closed until the next eye event."
                },
                "EYES_OPEN": {
                    "code": "EEG_ACT_EO",
                    "name": "Eyes open",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "MDC/2:24328",
                        "ieee": "MDC_EOG_EYE_MVMT_OPENING"
                    },
                    "description": "State-like: the eyes opened here and stay open until the next eye event."
                },
                "HYPERVENTILATION": {
                    "code": "EEG_ACT_HV",
                    "name": "Hyperventilation",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "SCT/68978004"
                    },
                    "description": "A span covering the whole hyperventilation; the start and end terms mark its edges as instants."
                },
                "HYPERVENTILATION_END": {
                    "code": "EEG_ACT_HV_END",
                    "name": "End of hyperventilation",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "DCM/130414"
                    }
                },
                "HYPERVENTILATION_START": {
                    "code": "EEG_ACT_HV_START",
                    "name": "Start of hyperventilation",
                    "class": "activation",
                    "standardCodes": {
                        "dicom": "DCM/130413"
                    }
                },
                "PHOTIC_STIMULATION": {
                    "code": "EEG_ACT_PHOTIC",
                    "name": "Photic stimulation",
                    "class": "activation",
                    "description": "Photic stimulation at an unstated frequency; the per-frequency terms are preferred. A span covers the train."
                },
