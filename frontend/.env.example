# This is an example environment configuration file for the frontend.
# Copy this file to .env and adjust the values as needed.

# The NODE_ENV variable is used by Vite to determine the mode (development or production).
NODE_ENV=development
# The VITE_API_BASE_URL variable specifies the base URL for API requests.
# Adjust it if your API is served from a different path.
VITE_API_BASE_URL=/
# The VITE_BACKEND_URL variable controls API routing in the dev server.
# Set to "mock" to use the in-memory mock API (no backend required).
# Set to a URL (e.g. http://localhost:8000) to proxy API requests to a real backend.
# Leave unset if the backend is served from the same origin (e.g. behind a reverse proxy).
# VITE_BACKEND_URL=mock
# The VITE_BASE_URL variable specifies the base URL for static asset requests.
# Adjust it if your assets are served from a different path.
VITE_BASE_URL=/
# The VITE_PROJECT variable selects the active project compiled into the frontend.
# Omit or leave blank for the base (no-op) plugin. Set to a project name (e.g. "example") to
# enable project-specific routes, viewer panels, and API hooks. Only one project can be
# active per build — changing this value requires a full rebuild (npm run build).
# VITE_PROJECT=example

# The VITE_PLUGINS variable lists the plugins compiled into the frontend, comma-separated,
# mirroring the backend's EPICURRENTS_PLUGINS. Each enabled plugin's routes, nav links,
# icons, and viewer hooks are merged in (see src/plugins/active.ts). Zero or more plugins
# may be enabled alongside the active project. Changing this requires a full rebuild.
# Managed by scripts/enable_plugin.sh / disable_plugin.sh.
# VITE_PLUGINS=dicom

# Hostnames the Vite dev server may be served under, beyond localhost — a remote
# workstation, a tunnel, or a container name. Comma-separated; leave empty for
# local development.
# VITE_DEV_ALLOWED_HOSTS=my-workstation,api.example.dev
