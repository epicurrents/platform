{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#root/*": "./*",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:base": "vite build --config vite.config.base.ts",
    "build:viewer": "cd viewer && npm run build:edition -- --profile full && rm -rf ../viewer-dist && node scripts/copy.mjs --from dist/full --to ../viewer-dist && cd .. && npm run build:base",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "link:projects": "node scripts/link-projects.mjs",
    "postinstall": "npm run link:projects"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@material-symbols/svg-400": "^0.45.10",
    "axios": "^1.19.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "pinia": "^4.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.25",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsconfig-replace-paths": "^1.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
