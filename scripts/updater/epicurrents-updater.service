[Unit]
Description=Epicurrents remote-maintenance agent (one tick)
Documentation=file:///usr/local/lib/epicurrents-updater/README.md
After=network-online.target docker.service podman.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/epicurrents-updater/epicurrents-updater.sh
# An update rebuilds every image and a rollback does it again; a tick that
# carries one runs for minutes, and systemd must not kill it half-way.
TimeoutStartSec=0
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Whatever the agent creates is root's alone unless it sets a mode itself; the
# files it publishes into the spool do.
UMask=0077
# No ProtectSystem, ProtectHome, PrivateTmp or ReadWritePaths, deliberately.
# Each of them puts the service in a mount namespace of its own, and rootful
# Podman sets up a container's mounts in the namespace of the process that
# starts it: containers started from here would carry mounts the host cannot
# see. NoNewPrivileges is left out for the same runtime: it forbids the SELinux
# domain transition a container process makes on a Red Hat host. The agent's
# own defence is that it trusts nothing in the spool (see the script's header).
